{
  "name": "@iiinigence/sendgrid-mcp",
  "version": "0.1.3",
  "description": "Unofficial open-source SendGrid MCP server by IIInigence \u2014 let Claude and other AI assistants send emails, run campaigns, manage contacts, and read stats via SendGrid.",
  "license": "MIT",
  "author": "IIInigence (https://iiinigence.com)",
  "homepage": "https://iiinigence.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/iiinigence/sendgrid-mcp.git"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "sendgrid",
    "email",
    "claude",
    "ai",
    "automation",
    "iiinigence"
  ],
  "type": "module",
  "bin": {
    "iiinigence-sendgrid-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "PRIVACY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}